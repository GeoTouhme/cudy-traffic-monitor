# The binary reads environment variables; load this file explicitly in your shell.
# Compose loads the root .env via the documented --env-file command.
PROVIDER_MODE=mock
POLL_INTERVAL=30s
REQUEST_TIMEOUT=5s
MAX_RETRIES=2
DATABASE_PATH=data/monitor.db
HTTP_LISTEN_ADDRESS=127.0.0.1:8080
LOG_LEVEL=info
TIME_ZONE=UTC

# Reserved for a future validated provider. No router requests run today.
ROUTER_ADDRESS=
ROUTER_USERNAME=
ROUTER_PASSWORD=
# Alternative to ROUTER_PASSWORD: protected local file containing the password.
ROUTER_PASSWORD_FILE=
